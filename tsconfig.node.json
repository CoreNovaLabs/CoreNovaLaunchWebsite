{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // A composite project must emit; without an outDir `tsc -b` drops vite.config.js and
    // vite.config.d.ts next to the source, and Vite resolves `vite.config.js` BEFORE
    // `vite.config.ts` — the stale emit would silently shadow the real config.
    "outDir": "./node_modules/.tmp/tsconfig-node"
  },
  "include": ["vite.config.ts"]
}
